<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="28dp"
    android:paddingEnd="48dp"
    android:paddingBottom="12dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_launcher" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_name"
                android:textColor="@color/text"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tagline"
                android:textColor="@color/text_faint"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout style="@style/Chip">
            <ImageView android:id="@+id/net_dot" android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/dot_off" />
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="8dp" android:src="@drawable/ic_wifi" />
            <TextView android:id="@+id/net_text" style="@style/ChipText" />
        </LinearLayout>

        <LinearLayout style="@style/Chip">
            <ImageView android:id="@+id/usb_dot" android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/dot_off" />
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="8dp" android:src="@drawable/ic_usb" />
            <TextView android:id="@+id/usb_text" style="@style/ChipText" />
        </LinearLayout>

        <LinearLayout android:id="@+id/next_chip" style="@style/Chip" android:layout_marginEnd="24dp" android:visibility="gone">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_bell" />
            <TextView android:id="@+id/next_text" style="@style/ChipText" android:maxWidth="260dp" android:singleLine="true" android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="@color/text"
                android:textSize="38sp" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEEE, d MMMM"
                android:format24Hour="EEEE, d MMMM"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Greeting -->
    <TextView
        android:id="@+id/greet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="18dp"
        android:fontFamily="sans-serif-light"
        android:textColor="@color/text"
        android:textSize="30sp" />

    <TextView
        android:id="@+id/message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:maxWidth="900dp"
        android:textColor="@color/text_dim"
        android:textSize="16sp"
        android:textStyle="italic" />

    <!-- Inputs (only shown when WOW OS can switch them) -->
    <TextView android:id="@+id/sec_inputs" style="@style/Section" android:layout_marginTop="14dp" android:text="@string/sec_inputs" android:visibility="gone" />

    <HorizontalScrollView
        android:id="@+id/inputs_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/inputs_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />
    </HorizontalScrollView>

    <!-- Quick actions -->
    <TextView style="@style/Section" android:layout_marginTop="14dp" android:text="@string/sec_quick" />

    <HorizontalScrollView
        android:id="@+id/quick_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/quick_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />
    </HorizontalScrollView>

    <!-- Favourites -->
    <TextView style="@style/Section" android:layout_marginTop="6dp" android:text="@string/sec_favs" />

    <HorizontalScrollView
        android:id="@+id/fav_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/fav_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/fav_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginBottom="8dp"
        android:text="@string/fav_hint"
        android:textColor="@color/text_faint"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- All apps -->
    <TextView style="@style/Section" android:layout_marginTop="6dp" android:text="@string/sec_all" />

    <HorizontalScrollView
        android:id="@+id/all_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/all_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />
    </HorizontalScrollView>
</LinearLayout>
</ScrollView>
