<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="20dp" />
            <gradient android:angle="270" android:startColor="#24FFFFFF" android:endColor="#0AFFFFFF" />
            <stroke android:width="1dp" android:color="#30FFFFFF" />
        </shape>
    </item>
    <!-- thin top highlight, like light catching the edge of glass -->
    <item android:left="18dp" android:right="18dp" android:top="1dp" android:height="1dp" android:gravity="top">
        <shape>
            <gradient android:startColor="#00FFFFFF" android:centerColor="#80FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
